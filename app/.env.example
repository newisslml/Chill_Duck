# Copia este archivo como `.env` y completa con los datos de tu proyecto Supabase
# (Project Settings → API). En Vercel, define las mismas variables en Settings → Environment Variables.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Clave pública VAPID (la misma que VAPID_PUBLIC_KEY en los secretos de Supabase).
VITE_VAPID_PUBLIC_KEY=B...
